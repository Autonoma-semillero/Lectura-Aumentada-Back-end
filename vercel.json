{
  "version": 2,
  "builds": [
    {
      "src": "api/[...all].ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "node_modules/argon2/prebuilds/**"
      }
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "/api/[...all].ts"
    },
    {
      "src": "/(.*)",
      "dest": "/api/[...all].ts"
    }
  ]
}
